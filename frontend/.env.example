# MetroHealth AI - Frontend Environment Variables

# Live Production Backend URL:
# When your backend is deployed (e.g. on Render, Railway, Fly.io, or VPS), set this to your backend's base URL:
VITE_API_BASE_URL=https://your-backend-app.onrender.com

# Local Development:
# Leave commented or empty to automatically use Vite local proxy (/api -> http://127.0.0.1:8000)
# VITE_API_BASE_URL=
