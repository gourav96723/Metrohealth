# HealthSense AI - Environment Variables Template
# Copy to .env and adjust for local or production deployment

# Backend Secrets & Security
SECRET_KEY=healthsense-replace-with-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default SQLite for zero-config local run)
DATABASE_URL=sqlite:///./healthsense.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/healthsense

# Emergency Helpline Configuration
EMERGENCY_PHONE=911 / 112 / 102

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
